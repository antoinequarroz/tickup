# Dossier de la base SQLite
DATA_DIR=./data

# --- Échanges avec la suite ---
# Jeton pour l'API : les autres outils (Lamio, Hermes, Claude Code, un script) appellent TickUp avec
# « Authorization: Bearer <API_TOKEN> ». 24 caractères au moins, par exemple : openssl rand -base64 32
API_TOKEN=

# Adresse prévenue à chaque changement (ticket créé, modifié, commenté, supprimé…), en JSON.
SUITE_WEBHOOK_URL=
# Jeton envoyé avec ces événements (« Authorization: Bearer … »), si l'outil d'en face en demande un.
SUITE_WEBHOOK_TOKEN=
# Adresse publique de TickUp, jointe aux événements pour fabriquer des liens vers les tickets.
APP_URL=

# --- Les autres outils de la suite ---
# Donne l'adresse d'un outil pour le brancher : il apparaît dans « Suite » et dans la barre de gauche.
LAMIO_URL=
# Secret partagé avec Lamio (le même que TICKUP_SSO_SECRET dans son .env), 32 caractères au moins :
# avec LAMIO_URL, on entre dans TickUp avec son compte Lamio. Par exemple : openssl rand -base64 48
LAMIO_SSO_SECRET=
CAIRN_URL=
METRICOVE_URL=
ALFRED_URL=
NINO_URL=

# À mettre à "true" seulement pour tester l'image de production en http (sans HTTPS, le cookie de session est refusé).
INSECURE_COOKIE=
