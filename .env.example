# Dossier de la base SQLite
DATA_DIR=./data

# --- Échanges avec la suite ---
# Jeton pour l'API : les autres outils (Cordée, Hermes, Claude Code, un script) appellent TickUp avec
# « Authorization: Bearer <API_TOKEN> ». 24 caractères au moins, par exemple : openssl rand -base64 32
API_TOKEN=

# Adresse prévenue à chaque changement (ticket créé, modifié, commenté, supprimé…), en JSON.
SUITE_WEBHOOK_URL=
# Jeton envoyé avec ces événements (« Authorization: Bearer … »), si l'outil d'en face en demande un.
SUITE_WEBHOOK_TOKEN=
# Adresse publique de TickUp, sans barre finale : jointe aux événements pour fabriquer des liens vers
# les tickets, et adresse de retour de la connexion par Compte Postmelo.
APP_URL=

# --- Compte Postmelo : le compte unique de la suite ---
# Avec COMPTE_URL, COMPTE_CLIENT_SECRET et APP_URL (ci-dessus), la page de connexion propose
# « Continuer avec mon Compte Postmelo ». Le mot de passe TickUp reste disponible en secours.
# Sans elles, rien ne change. Le secret (32 caractères au moins) est le même que TICKUP_CLIENT_SECRET
# dans le .env du Compte Postmelo, où TICKUP_URL vaut APP_URL.
COMPTE_URL=
COMPTE_CLIENT_SECRET=

# --- GitHub ---
# Secret partagé avec les webhooks de tes dépôts GitHub (Settings → Webhooks → Secret). 16 caractères au
# moins, par exemple : openssl rand -hex 32. Adresse du webhook : https://<ton-tickup>/api/github/webhook,
# type application/json, événements « Pull requests » et « Pushes ».
GITHUB_WEBHOOK_SECRET=

# --- Notifications par e-mail ---
# Sans ces deux lignes, les notifications restent dans TickUp (la cloche) et personne ne reçoit d'e-mail.
# Avec elles, chacun peut choisir « Aussi par e-mail » dans Réglages › Notifications (jamais par défaut).
# Ex. smtps://tickup%40exemple.ch:mot-de-passe@mail.infomaniak.com:465
SMTP_URL=
# Ex. "TickUp <tickup@exemple.ch>"
MAIL_FROM=

# --- Les autres outils de la suite ---
# Donne l'adresse d'un outil pour le brancher : il apparaît dans « Suite » et dans la barre de gauche.
CORDEE_URL=
CAIRN_URL=
METRICOVE_URL=
ALFRED_URL=
NINO_URL=

# À mettre à "true" seulement pour tester l'image de production en http (sans HTTPS, le cookie de session est refusé).
INSECURE_COOKIE=

# Erreurs du serveur envoyées à Orbi (SDK Sentry). Vide = rien n'est envoyé.
# DSN du projet « TickUp » sur orbi.postmelo.ch (onglet Brancher).
SENTRY_DSN=
# Version affichée avec chaque erreur (facultatif), par exemple le commit déployé.
APP_RELEASE=
